<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AcademyHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcademyHub.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <!-- ============================================
             APP BAR
             ============================================ -->
        <header class="app-bar" id="appBar">
            <div class="app-bar__inner">
                <!-- Brand -->
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true">
                        <span class="brand__glyph">AH</span>
                        <span class="brand__dot"></span>
                    </span>
                    <span class="brand__name">
                        Academy<em>Hub</em>
                    </span>
                </a>

                <!-- Primary Navigation -->
                <nav class="app-nav" aria-label="Primary">
                    <a class="app-nav__link is-active" asp-area="" asp-controller="Home" asp-action="Index">
                        Overview
                    </a>
                    <a class="app-nav__link" asp-area="" asp-controller="Course" asp-action="Index">
                        Courses
                    </a>
                    <a class="app-nav__link" href="#">
                        Instructors
                    </a>
                    <a class="app-nav__link" href="#">
                        Students
                    </a>
                    <a class="app-nav__link" href="#">
                        Analytics
                    </a>
                </nav>

                <!-- Right actions -->
                <div class="app-actions">
                    <button type="button" class="search-trigger" aria-label="Search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <span class="search-trigger__label">Search</span>
                        <kbd class="search-trigger__kbd">⌘K</kbd>
                    </button>

                    <button type="button" class="icon-btn" aria-label="Notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                        </svg>
                        <span class="icon-btn__ping" aria-hidden="true"></span>
                    </button>

                    <button type="button" class="user-chip" aria-label="Account menu">
                        <span class="user-chip__avatar">MB</span>
                        <span class="user-chip__name">Mohamed</span>
                        <svg class="user-chip__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="app-bar__rule" aria-hidden="true"></div>
        </header>

        <!-- ============================================
             MAIN
             ============================================ -->
        <main class="app-main" role="main">
            @RenderBody()
        </main>

        <!-- ============================================
             FOOTER
             ============================================ -->
        <footer class="app-footer">
            <div class="app-footer__inner">
                <div class="app-footer__brand">
                    <span class="brand__mark brand__mark--sm" aria-hidden="true">
                        <span class="brand__glyph">AH</span>
                    </span>
                    <span>
                        <strong>AcademyHub</strong>
                        <em>Learning, structured.</em>
                    </span>
                </div>

                <nav class="app-footer__links" aria-label="Footer">
                    <a href="#">Documentation</a>
                    <a href="#">Changelog</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a href="#">Support</a>
                </nav>

                <div class="app-footer__meta">
                    <span>© @DateTime.Now.Year AcademyHub</span>
                    <span class="app-footer__status">
                        <span class="app-footer__status-dot"></span>
                        All systems operational
                    </span>
                </div>
            </div>
        </footer>
    </div>

    <style>
        /* ============================================================
                   INK & EMBER — Design Tokens
                   ============================================================ */
        :root {
            /* Surfaces */
            --bg: #faf8f3;
            --bg-tint: #f4f1ea;
            --surface: #ffffff;
            --surface-2: #f7f5ef;
            /* Ink */
            --ink: #141210;
            --ink-2: #3d3a35;
            --muted: #6b6660;
            --subtle: #9a938a;
            /* Lines */
            --border: #e8e3d7;
            --border-strong: #d8d2c2;
            /* Accent — Ember */
            --ember: #ea580c;
            --ember-hover: #c2410c;
            --ember-soft: #feefe4;
            --ember-ring: rgba(234, 88, 12, .22);
            /* Semantic */
            --sage: #15803d;
            --sage-soft: #e5f4e9;
            /* Radii */
            --r-xs: 6px;
            --r-sm: 8px;
            --r-md: 10px;
            --r-lg: 14px;
            --r-pill: 999px;
            /* Shadows */
            --sh-xs: 0 1px 2px rgba(20, 18, 16, .05);
            --sh-sm: 0 1px 3px rgba(20, 18, 16, .06), 0 1px 2px rgba(20, 18, 16, .04);
            --sh-md: 0 4px 12px rgba(20, 18, 16, .06), 0 2px 4px rgba(20, 18, 16, .04);
            /* Typography */
            --font-sans: "Inter", "IBM Plex Sans Arabic", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
            --font-mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #0a0a09;
                --bg-tint: #121110;
                --surface: #14130f;
                --surface-2: #1a1916;
                --ink: #f5f2ea;
                --ink-2: #d6d1c4;
                --muted: #a8a29a;
                --subtle: #6f6a61;
                --border: #26241e;
                --border-strong: #3a372e;
                --ember: #fb923c;
                --ember-hover: #fdba74;
                --ember-soft: rgba(251, 146, 60, .12);
                --ember-ring: rgba(251, 146, 60, .32);
                --sage: #4ade80;
                --sage-soft: rgba(74, 222, 128, .12);
                --sh-xs: 0 1px 2px rgba(0, 0, 0, .4);
                --sh-sm: 0 1px 3px rgba(0, 0, 0, .5);
                --sh-md: 0 4px 12px rgba(0, 0, 0, .5);
            }
        }

        /* ============================================================
                   Base
                   ============================================================ */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100dvh;
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font-sans);
            font-size: 15px;
            line-height: 1.5;
            font-feature-settings: "cv11", "ss01", "tnum";
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            /* Subtle warm grid texture */
            background-image: radial-gradient(circle at 12% -10%, rgba(234, 88, 12, .06), transparent 45%), radial-gradient(circle at 100% 0%, rgba(20, 18, 16, .04), transparent 40%);
            background-attachment: fixed;
        }

        ::selection {
            background: var(--ember);
            color: #fff;
        }

        /* ============================================================
                   App Shell
                   ============================================================ */
        .app-shell {
            display: flex;
            flex-direction: column;
            min-height: 100dvh;
        }

        /* ============================================================
                   App Bar
                   ============================================================ */
        .app-bar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(250, 248, 243, .82);
            backdrop-filter: saturate(180%) blur(14px);
            -webkit-backdrop-filter: saturate(180%) blur(14px);
            transition: background-color .25s ease, box-shadow .25s ease;
        }

        @@media (prefers-color-scheme: dark) {
            .app-bar {
                background: rgba(10, 10, 9, .78);
            }
        }

        .app-bar.is-scrolled {
            background: rgba(250, 248, 243, .95);
            box-shadow: 0 1px 0 var(--border), 0 8px 24px -12px rgba(20, 18, 16, .12);
        }

        @@media (prefers-color-scheme: dark) {
            .app-bar.is-scrolled {
                background: rgba(10, 10, 9, .95);
            }
        }

        .app-bar__inner {
            display: flex;
            align-items: center;
            gap: 2rem;
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
        }

        .app-bar__rule {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border) 20%, var(--border) 80%, transparent);
        }

        /* ============================================================
                   Brand
                   ============================================================ */
        .brand {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            text-decoration: none;
            color: var(--ink);
            flex-shrink: 0;
        }

        .brand__mark {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            background: var(--ink);
            color: var(--bg);
            border-radius: 9px;
            box-shadow: var(--sh-xs), inset 0 1px 0 rgba(255,255,255,.08);
            transition: transform .3s cubic-bezier(.2,.8,.2,1);
        }

        .brand:hover .brand__mark {
            transform: rotate(-4deg) scale(1.04);
        }

        .brand__glyph {
            font-family: var(--font-mono);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: -.02em;
        }

        .brand__dot {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 10px;
            height: 10px;
            background: var(--ember);
            border: 2px solid var(--bg);
            border-radius: 50%;
            box-shadow: 0 0 0 0 var(--ember-ring);
            animation: brand-pulse 2.4s ease-out infinite;
        }

        @@keyframes brand-pulse {
            0% {
                box-shadow: 0 0 0 0 var(--ember-ring);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(234, 88, 12, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(234, 88, 12, 0);
            }
        }

        .brand__name {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: -.015em;
        }

            .brand__name em {
                font-style: normal;
                color: var(--muted);
                font-weight: 500;
            }

        .brand__mark--sm {
            width: 28px;
            height: 28px;
            border-radius: 8px;
        }

            .brand__mark--sm .brand__glyph {
                font-size: 11px;
            }

        /* ============================================================
                   Primary Navigation
                   ============================================================ */
        .app-nav {
            display: flex;
            align-items: center;
            gap: .25rem;
            flex: 1;
            min-width: 0;
        }

        .app-nav__link {
            position: relative;
            display: inline-flex;
            align-items: center;
            height: 34px;
            padding: 0 .85rem;
            color: var(--muted);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: .01em;
            border-radius: var(--r-sm);
            transition: color .18s ease, background-color .18s ease;
        }

            .app-nav__link:hover {
                color: var(--ink);
                background: var(--surface-2);
            }

            .app-nav__link.is-active {
                color: var(--ink);
                font-weight: 600;
            }

                .app-nav__link.is-active::after {
                    content: "";
                    position: absolute;
                    left: 12px;
                    right: 12px;
                    bottom: -20px;
                    height: 2px;
                    background: var(--ember);
                    border-radius: 2px 2px 0 0;
                }

        /* ============================================================
                   Actions
                   ============================================================ */
        .app-actions {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex-shrink: 0;
        }

        /* Search trigger */
        .search-trigger {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            height: 34px;
            padding: 0 .6rem 0 .75rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
            color: var(--muted);
            font: inherit;
            font-size: 13px;
            cursor: pointer;
            transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
        }

            .search-trigger:hover {
                border-color: var(--border-strong);
                color: var(--ink);
                box-shadow: var(--sh-xs);
            }

            .search-trigger:focus-visible {
                outline: none;
                border-color: var(--ember);
                box-shadow: 0 0 0 3px var(--ember-ring);
            }

            .search-trigger svg {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
            }

        .search-trigger__label {
            font-weight: 500;
        }

        .search-trigger__kbd {
            display: inline-flex;
            align-items: center;
            padding: 2px 6px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 5px;
            color: var(--subtle);
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: -.03em;
        }

        /* Icon button */
        .icon-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: var(--r-sm);
            color: var(--muted);
            cursor: pointer;
            transition: background-color .18s ease, color .18s ease, border-color .18s ease;
        }

            .icon-btn:hover {
                background: var(--surface);
                border-color: var(--border);
                color: var(--ink);
            }

            .icon-btn:focus-visible {
                outline: none;
                border-color: var(--ember);
                box-shadow: 0 0 0 3px var(--ember-ring);
            }

            .icon-btn svg {
                width: 17px;
                height: 17px;
            }

        .icon-btn__ping {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 6px;
            height: 6px;
            background: var(--ember);
            border-radius: 50%;
            box-shadow: 0 0 0 2px var(--bg);
        }

        /* User chip */
        .user-chip {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            height: 34px;
            padding: 0 .55rem 0 .35rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-pill);
            color: var(--ink);
            font: inherit;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: border-color .18s ease, box-shadow .18s ease;
        }

            .user-chip:hover {
                border-color: var(--border-strong);
                box-shadow: var(--sh-xs);
            }

            .user-chip:focus-visible {
                outline: none;
                border-color: var(--ember);
                box-shadow: 0 0 0 3px var(--ember-ring);
            }

        .user-chip__avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            background: linear-gradient(135deg, var(--ember), var(--ember-hover));
            color: #fff;
            border-radius: 50%;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: -.02em;
        }

        .user-chip__name {
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-chip__caret {
            width: 13px;
            height: 13px;
            color: var(--subtle);
        }

        /* ============================================================
                   Main
                   ============================================================ */
        .app-main {
            flex: 1;
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        /* ============================================================
                   Footer
                   ============================================================ */
        .app-footer {
            border-top: 1px solid var(--border);
            background: var(--bg-tint);
        }

        .app-footer__inner {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 2rem;
            max-width: 1320px;
            margin: 0 auto;
            padding: 24px;
            font-size: 13px;
        }

        .app-footer__brand {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

            .app-footer__brand strong {
                display: block;
                font-weight: 700;
                color: var(--ink);
                font-size: 13px;
            }

            .app-footer__brand em {
                display: block;
                font-style: normal;
                color: var(--muted);
                font-size: 12px;
            }

        .app-footer__links {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
        }

            .app-footer__links a {
                color: var(--muted);
                text-decoration: none;
                font-weight: 500;
                transition: color .18s ease;
            }

                .app-footer__links a:hover {
                    color: var(--ember);
                }

        .app-footer__meta {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            align-items: center;
            color: var(--subtle);
            font-family: var(--font-mono);
            font-size: 11.5px;
            letter-spacing: -.01em;
        }

        .app-footer__status {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: var(--sage);
        }

        .app-footer__status-dot {
            width: 6px;
            height: 6px;
            background: var(--sage);
            border-radius: 50%;
            box-shadow: 0 0 0 3px var(--sage-soft);
        }

        /* ============================================================
                   RTL support
                   ============================================================ */
        html[dir="rtl"] .brand__dot {
            right: auto;
            left: -2px;
        }

        html[dir="rtl"] .icon-btn__ping {
            right: auto;
            left: 7px;
        }

        html[dir="rtl"] .app-footer__meta {
            justify-content: flex-start;
        }

        html[dir="rtl"] .app-footer__brand,
        html[dir="rtl"] .app-footer__links {
            direction: rtl;
        }

        /* ============================================================
                   Responsive
                   ============================================================ */
        @@media (max-width: 1024px) {
            .search-trigger__label {
                display: none;
            }

            .app-nav__link {
                padding: 0 .6rem;
            }

            .user-chip__name {
                display: none;
            }
        }

        @@media (max-width: 860px) {
            .app-bar__inner {
                gap: 1rem;
                padding: 0 16px;
                height: 58px;
            }

            .app-nav {
                gap: 0;
                overflow-x: auto;
                scrollbar-width: none;
                -webkit-overflow-scrolling: touch;
            }

                .app-nav::-webkit-scrollbar {
                    display: none;
                }

            .app-nav__link.is-active::after {
                bottom: -14px;
            }

            .app-footer__inner {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 1.25rem;
            }

            .app-footer__brand,
            .app-footer__meta {
                justify-content: center;
            }
        }

        @@media (max-width: 560px) {
            .app-main {
                padding: 20px 16px 48px;
            }

            .brand__name {
                display: none;
            }

            .search-trigger__kbd {
                display: none;
            }
        }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // App bar elevation on scroll
        (function () {
            var bar = document.getElementById('appBar');
            if (!bar) return;
            var onScroll = function () {
                bar.classList.toggle('is-scrolled', window.scrollY > 8);
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>